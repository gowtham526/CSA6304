from collections import Counter

events = [
    {"user": "admin", "status": "failed", "source": "firewall"},
    {"user": "john", "status": "success", "source": "server"},
    {"user": "admin", "status": "failed", "source": "server"},
    {"user": "john", "status": "failed", "source": "firewall"},
    {"user": "admin", "status": "success", "source": "server"}
]

search = input("Enter search keyword: ").lower()

filtered = [event for event in events if search in str(event).lower()]

print("\nSearch Results:")
for event in filtered:
    print(event)

field = input("\nEnter field for stats count (user/status/source): ")

if field in events[0]:
    counts = Counter(event[field] for event in events)
    print("\nStats Count:")
    print(dict(counts))
else:
    print("Invalid Field")
